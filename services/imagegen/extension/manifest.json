{
  "manifest_version": 3,
  "name": "Flow Kit",
  "version": "0.7.11",
  "description": "Local agent bridge for Google Flow API \u2014 captures tokens, solves reCAPTCHA, proxies API calls",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "webRequest",
    "scripting",
    "sidePanel",
    "debugger"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://flow-content.google/*",
    "https://www.gstatic.com/*",
    "https://ssl.gstatic.com/*",
    "https://*.gstatic.com/*",
    "https://labs.google/*",
    "https://aisandbox-pa.googleapis.com/*",
    "http://127.0.0.1:8100/*",
    "https://accounts.google.com/*",
    "https://storage.googleapis.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/*/tools/flow*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "side_panel": {
    "default_path": "side_panel.html"
  },
  "action": {
    "default_title": "Flow Kit"
  }
}
