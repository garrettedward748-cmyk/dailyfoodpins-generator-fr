{
  "manifest_version": 3,
  "name": "Gemini Chat",
  "version": "1.3.1",
  "description": "Runs the platform's Gemini prompts in this browser's signed-in Gemini page and hands the replies back to the agent.",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://accounts.google.com/*",
    "http://127.0.0.1:8100/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
