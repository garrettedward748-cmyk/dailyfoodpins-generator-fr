# The ONLY file you ever need to edit by hand.
# Everything else is configured in the web UI at http://localhost:8080/settings

# Required. Encrypts credentials stored in the database.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Optional
PORT=8080
DB_PATH=./data/platform.db
LOG_LEVEL=info
