{
  "name": "article-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted article generation and publishing platform",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./src/web/styles/input.css -o ./src/web/public/style.css --minify",
    "build": "npm run build:css && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "predev": "npm run build:css",
    "dev": "tsx watch src/index.ts",
    "watch:css": "tailwindcss -i ./src/web/styles/input.css -o ./src/web/public/style.css --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "import:sheets": "tsx src/scripts/import-sheets.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.3",
    "fastify": "^5.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
